package Game.User;

public class Start {
	private int State = 0;
	public Start() {}
	public  int getStartState() {
		return this.State;
	}
	
	public void gameClose() {
		System.exit(0);
	}
	public void setOption(int op) {
		try {
			Thread.sleep(4000);
			if(op == 1) {
				System.out.println("Ingresa tus credenciales");
			}else {
				System.out.println("comencemos una aventura");
			}
			
		}catch(InterruptedException e) {
			e.printStackTrace();
		}
	
		
	}
}
